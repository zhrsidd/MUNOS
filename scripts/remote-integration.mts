import {randomUUID,createHash} from 'node:crypto';
import {writeFile,readFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
import {clientFor,ids,session,ref} from './remote-context.mts';
import {SupabaseTransport} from '../lib/supabase/repository';
import {fingerprint} from '../lib/sync/repository';
import type {Command} from '../lib/commands';
import type {Role} from '../lib/domain';
const client=clientFor(),transport=new SupabaseTransport(client,ids.conference,session.user.id);
const fixtureFile='.test-sessions/integration.json';
const uuid=(id:string)=>{const h=createHash('sha256').update('conference-os-development:'+id).digest('hex');return `${h.slice(0,8)}-${h.slice(8,12)}-4${h.slice(13,16)}-a${h.slice(17,20)}-${h.slice(20,32)}`;};
const send=async(command:Command,role:Role='chair')=>{const d=await transport.read();const m={id:randomUUID(),command,role,actorId:session.user.id,createdAt:new Date().toISOString(),state:'pending' as const,expected:fingerprint(d,command)};await transport.send(m);return m;};
if(process.argv.includes('--prepare')){
 await send({type:'currentSession',committeeId:ids.ga1,sessionId:ids.session});
 const token=randomUUID().replaceAll('-',''),submission=randomUUID();
 await send({type:'submissionLink',action:'create',committeeId:ids.ga1,token,shareWith:''},'admin');
 const googleDocId='verification_'+randomUUID().replaceAll('-','');
 const fixture={token,submission,documentId:submission.slice(0,24)+'000000000001',googleDocId};await writeFile(fixtureFile,JSON.stringify(fixture),{mode:0o600});
 await writeFile('.test-sessions/submit-integration.sql',`begin; set local role service_role; select public.submit_resolution('${token}','${submission}','${ids.france}','Remote integration rehearsal','${googleDocId}',null,null,null,null); commit;`,{mode:0o600});
 console.log('Remote link and current session prepared; server-only submission SQL saved.');process.exit(0);
}
const fixture=JSON.parse(await readFile(fixtureFile,'utf8'));
let data=await transport.read();let doc=data.documents.find(r=>r.id===fixture.documentId)!;assert.equal(doc.status,'Draft');assert.equal(doc.sessionId,ids.session);
await send({type:'resolutionLink',documentId:doc.id,action:'access',access:'ok'});
await send({type:'resolutionLink',documentId:doc.id,action:'approvalCopy',docId:fixture.googleDocId+'_approval'});
for(const [status,role] of [['Submitted','chair'],['Review','approval'],['Approved','approval'],['Printed','logistics']] as const)await send({type:'document',id:doc.id,status},role);
data=await transport.read();for(const old of data.documents.filter(r=>r.committeeId===ids.ga1&&r.status==='In Debate'))await send({type:'document',id:old.id,status:'Closed',outcome:'Withdrawn'});
await send({type:'document',id:doc.id,status:'In Debate'});
for(const delegateId of [ids.france,ids.japan])await send({type:'attendance',sessionId:ids.session,delegateId,status:'Present'});
for(const old of (await transport.read()).speeches?.filter(s=>s.sessionId===ids.session&&s.state!=='finished')??[])await send({type:'speechFinish',sessionId:ids.session,speechId:old.id});
await send({type:'speechStart',sessionId:ids.session,resolutionId:doc.id,delegateId:ids.france,classification:'Main Submitter'});
let speech=(await transport.read()).speeches!.find(s=>s.state!=='finished'&&s.sessionId===ids.session)!;
const queueBefore=(await transport.read()).queue;
await send({type:'poiAdd',sessionId:ids.session,speechId:speech.id,delegateId:ids.japan});
assert.deepEqual((await transport.read()).queue,queueBefore);
await send({type:'poiAllowance',sessionId:ids.session,speechId:speech.id,limit:2});
const entry=(await transport.read()).poiQueue!.find(p=>p.speechId===speech.id)!;
const recognized=await send({type:'poiRecognize',sessionId:ids.session,speechId:speech.id,entryId:entry.id,points:2});await transport.send(recognized);
await send({type:'speechScore',sessionId:ids.session,speechId:speech.id,points:3});
await send({type:'speechYield',sessionId:ids.session,speechId:speech.id,delegateId:ids.japan});
speech=(await transport.read()).speeches!.find(s=>s.state!=='finished'&&s.sessionId===ids.session)!;
await send({type:'speechScore',sessionId:ids.session,speechId:speech.id,points:2});
await send({type:'speechFinish',sessionId:ids.session,speechId:speech.id});
await send({type:'debateMode',sessionId:ids.session,mode:'closed',phase:'against'});
for(const delegateId of [ids.france,ids.japan])await send({type:'queueAdd',sessionId:ids.session,delegateId,lane:'against'});
const order=(await transport.read()).queue.filter(q=>q.sessionId===ids.session&&q.lane==='against').sort((a,b)=>a.position-b.position).map(q=>q.id).reverse();await send({type:'queueOrder',sessionId:ids.session,lane:'against',ids:order});
await send({type:'voteMode',sessionId:ids.session,resolutionId:doc.id,mode:'divide',voteType:'substantive'});
await assert.rejects(()=>send({type:'vote',sessionId:ids.session,resolutionId:doc.id,delegateId:ids.france,choice:'Abstain'}));
for(const a of (await transport.read()).attendance.filter(a=>a.sessionId===ids.session&&a.status!=='Absent'))await send({type:'vote',sessionId:ids.session,resolutionId:doc.id,delegateId:a.delegateId,choice:'For'});
await send({type:'document',id:doc.id,status:'Closed',outcome:'Passed'});
await send({type:'sessionImport',rows:[{committeeId:ids.ga1,name:'Remote schedule rehearsal',startsAt:'2026-11-12T06:00:00Z',endsAt:'2026-11-12T07:00:00Z'}]},'admin');
const school=(await transport.read()).delegates.find(d=>d.id===ids.france)!.schoolId;
const photo=await send({type:'photoSlot',action:'create',schoolId:school,startsAt:new Date(Date.now()+5*60000).toISOString(),endsAt:null,location:'Main hall',note:'Development rehearsal'},'admin');
const photoId=photo.id.slice(0,24)+'000000000001';
const ack=await send({type:'photoAck',committeeId:ids.ga1,slotId:photoId,stage:'warning',revision:1});await transport.send(ack);
await send({type:'vetoRules',committeeId:ids.sc,enabled:true,delegateIds:['d15','d16','d17','d18','d19'].map(uuid)},'admin');
const fresh=await new SupabaseTransport(clientFor(),ids.conference,session.user.id).read();doc=fresh.documents.find(r=>r.id===doc.id)!;
assert.equal(doc.outcome,'Passed');assert.deepEqual(fresh.queue.filter(q=>q.sessionId===ids.session&&q.lane==='against').sort((a,b)=>a.position-b.position).map(q=>q.id),order);
assert.equal(fresh.events.filter(e=>e.id===recognized.id.slice(0,24)+'000000000001').length,1);
assert.equal(fresh.photoAcks!.filter(a=>a.slotId===photoId).length,1);
const report={at:new Date().toISOString(),project:ref,documentId:doc.id,googleDocDraft:true,chairApprovalPrintDebateVote:true,currentSession:true,poiIndependent:true,recognizedPoiExactlyOnce:true,mainCoSubmitter:true,queueOrderPersists:true,divideHouse:true,scheduleImport:true,photoAckExactlyOnce:true,scP5Configured:true,freshRepositoryPersistence:true};
await writeFile('docs/remote-integration-results.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));
