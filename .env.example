# ---- Browser-visible configuration (compiled into JavaScript; never put secrets here) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_DATA_BACKEND=local
# Enable only after reviewing shared-IP rate limits. Existing sessions are reused.
NEXT_PUBLIC_ENABLE_ANONYMOUS_BOOTSTRAP=false
NEXT_PUBLIC_CONFERENCE_ID=your-conference-uuid
# Optional; defaults to the package.json version.
NEXT_PUBLIC_APP_VERSION=0.2.0-dev
# Venue time zone for schedules and group photos (IANA name). Default Asia/Qatar.
NEXT_PUBLIC_CONFERENCE_TIMEZONE=Asia/Qatar
# Load tests use short-lived, pre-provisioned user sessions, never a service key.

# ---- Server-only configuration (Vercel: mark as Sensitive; never NEXT_PUBLIC_) ----
# Supabase secret key (sb_secret_...). Used only by server routes. Leave empty locally.
SUPABASE_SECRET_KEY=

# ---- Target guard (server/build/operator tooling; not secrets, but never NEXT_PUBLIC_) ----
# Fails closed. See docs/DEPLOYMENT.md "Target guard".
# The Production project ref. REQUIRED for a Vercel Production build, which fails unless NEXT_PUBLIC_SUPABASE_URL is exactly this project.
EXPECTED_SUPABASE_REF=
# Comma-separated refs of preproduction (staging / development) projects that load, rehearsal and verification tools may use. Never list the production ref.
# One hosted project only (docs/INFRASTRUCTURE_LIFECYCLE.md): list its ref in ONE of these two variables, never both, and never alongside EXPECTED_SUPABASE_REF.
# PHESMUN production is denied everywhere. The lifecycle lock and registry are required but not yet implemented (docs/V1_RELEASE_CHECKLIST.md).
# DEVELOPMENT_SUPABASE_REFS has no default (unset or empty allows none). While the single DCMUN project is in its development
# role, list it in STAGING_SUPABASE_REFS; at cutover it moves to EXPECTED_SUPABASE_REF in Production (docs/DEPLOYMENT.md).
STAGING_SUPABASE_REFS=
DEVELOPMENT_SUPABASE_REFS=
